# HLS Harness — Environment Variables
# Copy this file to .env and fill in your values,
# OR set these in your shell profile (~/.bashrc, ~/.zshrc, PowerShell $PROFILE)
# so the devcontainer inherits them automatically via remoteEnv.

# -------------------------------------------------------------------
# Required: your Azure OpenAI resource endpoint
# Format: https://<resource-name>.openai.azure.com/
# -------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# -------------------------------------------------------------------
# Judge model deployment name (used by the LLM rubric scorer and
# SpecInterpreter). Deploy gpt-5.4-pro (or gpt-4o) in your Azure
# OpenAI resource and set the deployment name here.
# Default if unset: gpt-5.4-pro
# -------------------------------------------------------------------
AZURE_OPENAI_DEPLOYMENT_JUDGE=gpt-5.4-pro

# -------------------------------------------------------------------
# Default agent deployment name (used by maf_agent.py / eval harness
# when no per-agent override is set). Also used by the demo app.
# Deploy gpt-5.4-nano (or gpt-4o-mini) in your Azure OpenAI resource.
# Required by the eval harness — no default fallback.
# -------------------------------------------------------------------
AZURE_OPENAI_DEPLOYMENT_AGENT=gpt-5.4-nano

# -------------------------------------------------------------------
# (Optional) When you onboard a new agent via hls-eval onboard,
# add its deployment env var here so the generated adapter stub
# can reference it. Example:
# AZURE_OPENAI_DEPLOYMENT_PRIOR_AUTH=gpt-5.4-nano
# -------------------------------------------------------------------
